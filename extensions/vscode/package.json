  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartcursor.applyLast",
        "title": "SmartCursor: Apply Last Approved Edit"
      }
    ]
  }
