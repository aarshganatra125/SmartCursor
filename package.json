{
  "name": "smartcursor",
  "version": "0.1.0",
  "description": "Context-aware AI desktop assistant that works on top of the applications you already use.",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/build-native.mjs",
    "dev": "node scripts/electron-vite.mjs dev --watch",
    "build": "node scripts/build-native.mjs && electron-vite build",
    "build:native": "node scripts/build-native.mjs",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "check": "npm test && npm run typecheck"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
